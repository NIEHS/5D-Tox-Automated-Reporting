# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Logs (regenerable)
*.log

# Playwright E2E test artifacts (screenshots captured during step-through)
tests/screenshots/

# SSH artifacts
svobodadl@*

# Git round-trip dev scaffolding (ADR-0005): local stand-in remote and the
# app's working clone. Ephemeral dev-only state, never committed.
# Renamed from .overleaf-* to .repo-* (Am.3); legacy names kept ignored so an
# un-migrated checkout doesn't accidentally stage the old dirs.
.repo-standin/
.repo-clone/
.overleaf-standin/
.overleaf-clone/

# Claude Code session transcripts — local working artifacts only. Never
# commit: they embed full conversation history and have leaked live
# credentials (HHS audit, 2026-06-22). Rotate any secret that lands here.
output/session_exports/

# Licensed Microsoft/Monotype fonts (Times New Roman, Arial, Calibri, Symbol).
# Used LOCALLY to measure reference typography; the .docx only NAMES these
# families (they exist on the Windows render machine), so they must never be
# committed to this public HHS repo. See project_configurable_fonts memory.
assets/fonts/
ttfonts.zip
times*.ttf

# Personal shell / environment dotfiles that live in the sandbox home dir but
# happen to sit at the repo root. Per-user, never shared.
.bash_profile
.bashrc
.profile
.zshrc
.zprofile
.gitconfig
.ripgreprc

# Editor / IDE local state (match both dir and stray-file forms)
.idea
.vscode

# Local caches and backups (regenerable; never committed)
.fulltext_cache/
*.bak-*
.rlm-code.duckdb.prereindex

# Claude Code local state: ignore everything under .claude EXCEPT shared,
# checked-in tooling (skills). settings.local.json / hooks / scheduled tasks
# are per-user; skills/ is team-shared.
.claude/*
!.claude/skills/

# Per-session data store (persisted working data + documents). NOT repo
# content — it's the local mount / working mirror of the GCS session buckets
# (gs://rlm-bmdx-sessions-<user>, see mount-gcs.sh); GCS is the safekeeping
# backend, not GitHub (this is a public HHS repo — never push study data here).
# The golden TEST fixtures are separate, under tests/fixtures/golden/.
sessions/
